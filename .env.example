# Template only. Import variables into the process environment, or explicitly run:
# node --env-file=.env app.js
# Do not put account Cookies, login results or tokens in this public template.

HOST=127.0.0.1
PORT=3000

# Comma-separated exact browser origins. Empty disables cross-origin access.
CORS_ALLOWED_ORIGINS=

# Set true only when a trusted reverse proxy is deliberately configured.
TRUST_PROXY=false

# Initial fixed limits: JSON bodies 1 MiB; uploads 10 MiB.
# These limits have no environment-variable overrides in this release.
